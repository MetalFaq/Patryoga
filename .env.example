# Used by Node.js outside Docker. Compose builds its internal URL from the
# POSTGRES_* values below; do not publish PostgreSQL port 5432 to the host.
DATABASE_URL=postgres://patryoga_app:change-this-local-password@localhost:5432/patryoga
POSTGRES_DB=patryoga
POSTGRES_USER=patryoga_app
POSTGRES_PASSWORD=change-this-to-a-long-random-value
NEXT_PUBLIC_APP_ENV=local
# Set this to the immutable tag deployed on this host (for example, 0.1.1-<commit>).
IMAGE_TAG=local
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated Google accounts allowed to administer the app.
AUTH_ALLOWED_EMAIL=
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3000
