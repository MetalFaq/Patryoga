# Used by Node.js outside Docker. Compose builds the app URL from APP_DB_* and
# keeps POSTGRES_* exclusively for database ownership and migrations.
DATABASE_URL=postgres://patryoga_runtime:change-this-runtime-password-to-a-long-random-value@localhost:5432/patryoga
POSTGRES_DB=patryoga
POSTGRES_USER=patryoga_owner
POSTGRES_PASSWORD=change-this-owner-password-to-a-long-random-value
# Dedicated runtime role. It must differ from POSTGRES_USER. The password must
# contain 32-128 URL-safe characters: letters, numbers, underscore or hyphen.
APP_DB_USER=patryoga_runtime
APP_DB_PASSWORD=change-this-runtime-password-to-a-long-random-value
NEXT_PUBLIC_APP_ENV=local
# Single-instance pilot limits. Multi-replica deployments need a shared store.
RATE_LIMIT_AUTH_MAX=60
RATE_LIMIT_BUSINESS_MAX=600
RATE_LIMIT_WINDOW_MS=60000
# Set this to the immutable tag deployed on this host (for example, 0.1.1-<commit>).
IMAGE_TAG=local
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated Google accounts allowed to administer the app.
AUTH_ALLOWED_EMAIL=
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3000
